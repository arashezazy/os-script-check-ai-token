#!/usr/bin/env bash
set -o pipefail

model="${1:-openai/gpt-4o-mini}"
prompt="${2:-سلام! به فارسی و کوتاه جواب بده.}"
key="${OPENROUTER_API_KEY:-}"

if [[ -z "$key" ]]; then
  read -rsp 'OpenRouter API key: ' key || exit 1
  printf '\n'
fi

if [[ -z "$key" ]]; then
  printf 'No OpenRouter API key provided.\n' >&2
  exit 1
fi

payload=$(jq -n --arg model "$model" --arg prompt "$prompt" '{
  model: $model,
  messages: [{role: "user", content: $prompt}],
  max_tokens: 50
}') || exit 1

printf 'Authorization: Bearer %s\n' "$key" |
  curl -sS --max-time 30 \
    https://openrouter.ai/api/v1/chat/completions \
    -H @- \
    -H 'Content-Type: application/json' \
    --data "$payload" |
  jq -er 'if .error then error(.error.message) else .choices[0].message.content end'
